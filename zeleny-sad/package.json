{
  "name": "green-garden-pwa",
  "private": true,
  "version": "0.3.0",
  "description": "Зелёный сад — уютная детская PWA-игра о восстановлении волшебного сада",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run && vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^20.17.10",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
